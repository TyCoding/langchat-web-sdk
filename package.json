{
  "name": "@langchat/web-sdk",
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build-lib && pnpm build-types",
    "build-lib": "vite build",
    "build-standalone": "vite build --config vite.standalone.config.ts",
    "build-types": "vue-tsc --emitDeclarationOnly --declaration -p tsconfig.app.json",
    "push": "pnpm build && npm publish --access public",
    "preview": "vite preview"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./types/main.d.ts"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "./style.css": "./dist/style.css",
  "files": [
    "dist",
    "types",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "markdown-it": "^14.1.0",
    "path": "^0.12.7",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/tsconfig": "^0.4.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "5.4.2",
    "vite": "^4.4.5",
    "vue-tsc": "1.8.27"
  }
}